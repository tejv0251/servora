{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app components/servora-dashboard.tsx components/servora-app.tsx components/technician-mobile.tsx components/job-assignment-dialog.tsx components/job-attachments-dialog.tsx lib db",
    "typecheck": "tsc --noEmit",
    "test": "node --require ./scripts/windows-userinfo.cjs --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "format": "oxfmt",
    "db:generate": "node scripts/drizzle-kit.cjs generate"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "react-resizable-panels": "4.12.3",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.10.1",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "undici": "7.29.1"
  },
  "type": "module"
}
